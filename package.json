{
  "name": "project-lint",
  "version": "0.0.4",
  "type": "module",
  "keywords": [
    "project-lint",
    "structure-lint",
    "lint",
    "project-structure",
    "structure-quality"
  ],
  "description": "A CLI tool to lint project structure",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "clean": "rm -rf ./lib",
    "schema": "NODE_NO_WARNINGS=1 ts-json-schema-generator --path ./src/types/config.ts --type ProjectLintConfig > projectlintrc.schema.json && prettier --write projectlintrc.schema.json",
    "start": "node lib/cli.js \"./**/*\"",
    "dev": "tsx src/cli.ts \"./**/*\"",
    "prepack": "npm run build && npm run schema",
    "test": "jest",
    "test.ci": "jest --ci --maxWorkers=7 --silent --coverage --reporters=default --reporters=jest-junit",
    "test.cov": "jest --coverage --testFailureExitCode=0",
    "ci.prettier": "prettier",
    "ci.eslint": "eslint",
    "ci.typecheck": "tsc --noEmit",
    "ci.project-lint": "project-lint",
    "ci.lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "extends/**",
    "lib/**/*",
    "projectlintrc.schema.json",
    "src/**/*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./extends/*": "./extends/*",
    "./projectlintrc.schema.json": "./projectlintrc.schema.json",
    "./extends/typescript/*": "./extends/javascript/*"
  },
  "bin": {
    "project-lint": "./lib/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seitbekir/project-lint.git"
  },
  "author": "Seitbekir Seidametov",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "15.0.0",
    "es-main": "1.4.0",
    "globby": "16.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-json-schema-generator": "2.9.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
