workdir: .

gitignore: true

ignorePatterns:
  - node_modules
  - .husky
  - .git

extends:
  - extends/basic.yaml
  - extends/projectlint.yaml
  - extends/javascript/jest.yaml
  - extends/editorconfig.yaml
  - extends/ides/vscode.yaml
  - extends/ides/idea.yaml
  - extends/ides/zed.yaml
  - extends/javascript/typescript.yaml
  - extends/javascript/eslint.yaml
  - extends/javascript/prettier.yaml
  - extends/javascript/npm.yaml
  - extends/javascript/nvm.yaml
  - extends/git.yaml
  - extends/javascript/lint-staged.yaml
  - extends/ci-cd/github.yaml

root:
  - ruleId: index_file
  - ruleId: jest_folder
  - ruleId: project_root
  - ruleId: lintstaged_root
  - ruleId: github_root
  - name: projectlintrc.schema.json
    type: file
  - name: extends
    type: dir
    children:
      - name: /^${{kebab-case}}\.yaml$/
        type: file
      - name: /^(javascript|typescript|ci-cd|ides)$/
        type: dir
        children:
          - name: /^${{kebab-case}}\.yaml$/
            type: file
  - name: src
    type: dir
    children:
      - ruleId: jest_folder
      - name: cli.ts
        type: file
      - name: runner.ts
        type: file
      - ruleId: index_file
      - name: errors
        type: dir
        children:
          - ruleId: jest_folder
          - ruleId: index_file
          - name: /^${{PascalCase}}Error.ts$/
            type: file
      - name: helpers
        type: dir
        children:
          - ruleId: jest_folder
          - name: /^${{camelCase}}.ts$/
            type: file
      - name: types
        type: dir
        children:
          - ruleId: jest_folder
          - name: /^${{camelCase}}.ts$/
            type: file
      - name: utils
        type: dir
        children:
          - ruleId: jest_folder
          - name: /^${{camelCase}}.ts$/
            type: file
      - name: validators
        type: dir
        children:
          - ruleId: jest_folder
          - name: /^${{camelCase}}.ts$/
            type: file

rules:
  # Defaults
  jest_folder:
    - name: __tests__
      type: dir
      ignoreChildren: true
    - name: __mocks__
      type: dir
      ignoreChildren: true

  # My rules
  project_root:
    - ruleId: basic_root
    - ruleId: projectlint_root
    - ruleId: jest_root
    - ruleId: editorconfig_root
    - ruleId: vscode_root
    - ruleId: idea_root
    - ruleId: zed_root
    - ruleId: ts_root
    - ruleId: eslint_root
    - ruleId: prettier_root
    - ruleId: npm_root
    - ruleId: nvm_root
    - ruleId: git_root

  index_file:
    - name: index.ts
      type: file
